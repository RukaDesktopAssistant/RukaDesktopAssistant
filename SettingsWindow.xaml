<Window x:Class="RukaDesktopAssistant.SettingsWindow" Title="Ruka 設定"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="960" Height="680" MinWidth="820" MinHeight="560">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="0,0,1,0">
            <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged">
                <ListBoxItem Content="システム"/><ListBoxItem Content="外観"/><ListBoxItem Content="会話"/>
                <ListBoxItem Content="音声"/><ListBoxItem Content="AI"/><ListBoxItem Content="記憶"/>
                <ListBoxItem Content="PC操作"/><ListBoxItem Content="ゲーム"/><ListBoxItem Content="通知"/>
                <ListBoxItem Content="キャラクター"/><ListBoxItem Content="権限"/><ListBoxItem Content="ショートカット"/>
            </ListBox>
        </Border>
        <ScrollViewer Grid.Column="1" Padding="32">
            <StackPanel>
                <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDescription" Margin="0,8,0,24" TextWrapping="Wrap"/>

                <StackPanel x:Name="SystemPage">
                    <GroupBox Header="基本動作"><StackPanel Margin="12">
                        <CheckBox x:Name="StartWithWindows" Content="Windows起動時にるかを起動する" Margin="0,8"/>
                        <CheckBox x:Name="ShowDuringGames" Content="ゲーム中もるかを表示する" Margin="0,8"/>
                        <CheckBox x:Name="DiscordWakeWordOnly" Content="通話中はウェイクワード待機にする" Margin="0,8"/>
                        <CheckBox x:Name="AutonomousBehavior" Content="自律行動を有効にする" Margin="0,8"/>
                        <CheckBox x:Name="DangerousConfirmation" Content="危険なPC操作は必ず確認する" Margin="0,8"/>
                    </StackPanel></GroupBox>
                </StackPanel>

                <StackPanel x:Name="AppearancePage" Visibility="Collapsed"><GroupBox Header="外観"><StackPanel Margin="12">
                    <TextBlock Text="キャラクターサイズ"/><Slider x:Name="ScaleSlider" Minimum=".5" Maximum="2" TickFrequency=".1" IsSnapToTickEnabled="True"/>
                    <TextBlock x:Name="ScaleValue"/><TextBlock Text="透明度" Margin="0,12,0,0"/>
                    <Slider x:Name="OpacitySlider" Minimum=".2" Maximum="1" TickFrequency=".05" IsSnapToTickEnabled="True"/><TextBlock x:Name="OpacityValue"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="ConversationPage" Visibility="Collapsed"><GroupBox Header="会話履歴"><StackPanel Margin="12">
                    <TextBlock Text="会話履歴は長期記憶とは別に保存されます。" TextWrapping="Wrap"/>
                    <Button Content="会話履歴をすべて削除" Width="190" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ClearHistory_Click"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="VoicePage" Visibility="Collapsed"><GroupBox Header="音声"><StackPanel Margin="12">
                    <CheckBox x:Name="VoiceInputEnabled" Content="音声入力を有効にする" Margin="0,6"/>
                    <CheckBox x:Name="WakeEnabled" Content="ウェイクワードを有効にする" Margin="0,6"/>
                    <TextBlock Text="ウェイクワード"/><TextBox x:Name="WakePhrase" Margin="0,4,0,8"/>
                    <CheckBox x:Name="TtsEnabled" Content="音声合成を有効にする" Margin="0,6"/>
                    <TextBlock Text="音声速度"/><Slider x:Name="VoiceRate" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="音量"/><Slider x:Name="VoiceVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="AiPage" Visibility="Collapsed"><GroupBox Header="AI接続"><StackPanel Margin="12">
                    <TextBlock Text="プロバイダー"/><ComboBox x:Name="AiProvider"><ComboBoxItem Content="local"/><ComboBoxItem Content="openai"/><ComboBoxItem Content="http"/></ComboBox>
                    <TextBlock Text="APIキー" Margin="0,10,0,0"/><TextBox x:Name="AiApiKey"/>
                    <TextBlock Text="APIエンドポイント" Margin="0,10,0,0"/><TextBox x:Name="AiEndpoint"/>
                    <TextBlock Text="モデル" Margin="0,10,0,0"/><TextBox x:Name="AiModel"/>
                    <CheckBox x:Name="SendHistory" Content="直近の会話履歴を送信する" Margin="0,8"/>
                    <TextBlock Text="履歴件数"/><Slider x:Name="HistoryCount" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <Button Content="AI接続テスト（実際に1回送信）" Margin="0,12,0,0" Padding="10,6" Click="TestAi_Click"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="MemoryPage" Visibility="Collapsed"><GroupBox Header="長期記憶"><StackPanel Margin="12">
                    <ListBox x:Name="MemoryList" MinHeight="150"/><Button Content="選択した記憶を削除" Width="180" HorizontalAlignment="Left" Margin="0,8" Click="DeleteMemory_Click"/>
                    <TextBox x:Name="MemoryInput" Margin="0,8,0,0"/><Button Content="記憶を追加" Width="120" HorizontalAlignment="Left" Margin="0,8" Click="AddMemory_Click"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="PcPage" Visibility="Collapsed"><GroupBox Header="PC操作"><StackPanel Margin="12">
                    <TextBlock Text="るかは自然文の命令から、許可された範囲だけPC操作を実行します。" TextWrapping="Wrap"/>
                    <TextBlock Text="危険操作は確認ダイアログを通します。" Margin="0,8,0,0"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="GamePage" Visibility="Collapsed"><GroupBox Header="ゲームごとの設定"><StackPanel Margin="12">
                    <ComboBox x:Name="GameName" IsEditable="True"><ComboBoxItem Content="RobloxPlayerBeta"/><ComboBoxItem Content="FortniteClient-Win64-Shipping"/><ComboBoxItem Content="VALORANT-Win64-Shipping"/><ComboBoxItem Content="r5apex"/><ComboBoxItem Content="Minecraft"/></ComboBox>
                    <CheckBox x:Name="GameShow" Content="キャラクターを表示" Margin="0,8"/><CheckBox x:Name="GameMoveSide" Content="画面端へ移動" Margin="0,8"/><CheckBox x:Name="GameVoice" Content="音声反応を許可" Margin="0,8"/>
                    <TextBlock Text="サイズ"/><Slider x:Name="GameScale" Minimum=".5" Maximum="2" TickFrequency=".1" IsSnapToTickEnabled="True"/>
                    <Button Content="このゲーム設定を保存" Width="180" HorizontalAlignment="Left" Margin="0,10" Click="SaveGame_Click"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="NotificationPage" Visibility="Collapsed"><GroupBox Header="通知"><StackPanel Margin="12">
                    <CheckBox x:Name="NotificationsEnabled" Content="通知を有効にする" Margin="0,6"/>
                    <TextBlock Text="現在は安全なフォールバック通知を使用します。" Margin="0,8" TextWrapping="Wrap"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="CharacterPage" Visibility="Collapsed"><GroupBox Header="キャラクター"><StackPanel Margin="12">
                    <TextBlock Text="ruka-idle.png / talk / sleep / walk-1 / walk-2 をAssetsに置くと自動的に使用します。" TextWrapping="Wrap"/>
                    <TextBlock Text="将来Live2Dへ差し替えられるアセット構造になっています。" Margin="0,8" TextWrapping="Wrap"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="PermissionPage" Visibility="Collapsed"><GroupBox Header="権限"><StackPanel Margin="12">
                    <CheckBox x:Name="AllowScreenRead" Content="画面・アプリ状態の読み取り" Margin="0,6"/><CheckBox x:Name="AllowLaunchApps" Content="アプリ起動" Margin="0,6"/>
                    <CheckBox x:Name="AllowCloseApps" Content="アプリ終了" Margin="0,6"/><CheckBox x:Name="AllowFileRead" Content="ファイル読み取り" Margin="0,6"/>
                    <CheckBox x:Name="AllowFileWrite" Content="ファイル変更" Margin="0,6"/><CheckBox x:Name="AllowBrowserControl" Content="ブラウザ操作" Margin="0,6"/>
                    <CheckBox x:Name="AllowSystemSettings" Content="Windows設定・システム操作" Margin="0,6"/>
                </StackPanel></GroupBox></StackPanel>

                <StackPanel x:Name="ShortcutPage" Visibility="Collapsed"><GroupBox Header="ショートカット"><StackPanel Margin="12">
                    <TextBlock Text="F12：待機 / 再開"/><TextBlock Text="Ctrl + Alt + R：チャット"/><TextBlock Text="Ctrl + Alt + Esc：緊急停止" Margin="0,6"/>
                </StackPanel></GroupBox></StackPanel>

                <Button Content="設定を保存" Width="140" HorizontalAlignment="Right" Padding="12,8" Margin="0,20,0,0" Click="Save_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>