<Window x:Class="RukaDesktopAssistant.ChatWindow" Title="Ruka - Chat"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="720" Height="560" MinWidth="480" MinHeight="360">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="History" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Messages" />
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <Button Content="送信" Width="80" Click="Send_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <TextBox x:Name="Input" AcceptsReturn="True" MinHeight="42" VerticalContentAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
