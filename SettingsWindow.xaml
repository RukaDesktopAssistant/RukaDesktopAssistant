<Window x:Class="RukaDesktopAssistant.SettingsWindow" Title="Ruka 設定"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900" Height="620" MinWidth="760" MinHeight="500">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="0,0,1,0">
            <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged">
                <ListBoxItem Content="システム"/><ListBoxItem Content="外観"/><ListBoxItem Content="会話"/>
                <ListBoxItem Content="音声"/><ListBoxItem Content="AI"/><ListBoxItem Content="記憶"/>
                <ListBoxItem Content="PC操作"/><ListBoxItem Content="ゲーム"/><ListBoxItem Content="通知"/>
                <ListBoxItem Content="キャラクター"/><ListBoxItem Content="権限"/><ListBoxItem Content="ショートカット"/>
            </ListBox>
        </Border>
        <ScrollViewer Grid.Column="1" Padding="32">
            <StackPanel>
                <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Text="システム"/>
                <TextBlock x:Name="PageDescription" Margin="0,10,0,28" TextWrapping="Wrap"/>
                <GroupBox Header="基本動作" Margin="0,0,0,18">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="StartWithWindows" Content="Windows起動時にるかを起動する" Margin="0,8"/>
                        <CheckBox x:Name="ShowDuringGames" Content="ゲーム中もるかを表示する" Margin="0,8"/>
                        <CheckBox x:Name="DiscordWakeWordOnly" Content="Discord通話中はウェイクワード待機にする" Margin="0,8"/>
                        <CheckBox x:Name="AutonomousBehavior" Content="自律行動を有効にする" Margin="0,8"/>
                        <CheckBox x:Name="DangerousConfirmation" Content="危険なPC操作は必ず確認する" Margin="0,8"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="外観" Margin="0,0,0,18">
                    <StackPanel Margin="12">
                        <TextBlock Text="キャラクターサイズ"/>
                        <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,6"/>
                        <TextBlock x:Name="ScaleValue" Margin="0,0,0,10"/>
                        <TextBlock Text="透明度"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,6"/>
                        <TextBlock x:Name="OpacityValue"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="音声" Margin="0,0,0,18">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="VoiceInputEnabled" Content="音声入力を有効にする" Margin="0,6"/>
                        <CheckBox x:Name="WakeEnabled" Content="ウェイクワードを有効にする" Margin="0,6"/>
                        <TextBlock Text="ウェイクワード"/>
                        <TextBox x:Name="WakePhrase" Margin="0,4,0,8"/>
                        <CheckBox x:Name="TtsEnabled" Content="音声合成を有効にする" Margin="0,6"/>
                        <TextBlock Text="音声速度"/>
                        <Slider x:Name="VoiceRate" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="音量"/>
                        <Slider x:Name="VoiceVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="AI接続" Margin="0,0,0,18">
                    <StackPanel Margin="12">
                        <TextBlock Text="プロバイダー"/>
                        <ComboBox x:Name="AiProvider" Margin="0,4,0,8">
                            <ComboBoxItem Content="local"/>
                            <ComboBoxItem Content="http"/>
                        </ComboBox>
                        <TextBlock Text="HTTPエンドポイント（http選択時）"/>
                        <TextBox x:Name="AiEndpoint" Margin="0,4,0,8"/>
                        <CheckBox x:Name="SendHistory" Content="直近の会話履歴を送信する" Margin="0,6"/>
                        <TextBlock Text="送信する履歴件数"/>
                        <Slider x:Name="HistoryCount" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="権限" Margin="0,0,0,18">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="AllowScreenRead" Content="画面・アプリ状態の読み取りを許可" Margin="0,6"/>
                        <CheckBox x:Name="AllowLaunchApps" Content="アプリの起動を許可" Margin="0,6"/>
                        <CheckBox x:Name="AllowCloseApps" Content="アプリの終了を許可" Margin="0,6"/>
                        <CheckBox x:Name="AllowFileRead" Content="ファイルの読み取りを許可" Margin="0,6"/>
                        <CheckBox x:Name="AllowFileWrite" Content="ファイルの変更を許可" Margin="0,6"/>
                        <CheckBox x:Name="AllowBrowserControl" Content="ブラウザ操作を許可" Margin="0,6"/>
                        <CheckBox x:Name="AllowSystemSettings" Content="Windows設定の変更を許可" Margin="0,6"/>
                    </StackPanel>
                </GroupBox>
                <Button Content="設定を保存" Width="140" HorizontalAlignment="Right" Padding="12,8" Click="Save_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>