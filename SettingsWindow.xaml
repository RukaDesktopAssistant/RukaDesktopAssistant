<Window x:Class="RukaDesktopAssistant.SettingsWindow" Title="Ruka 設定"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="900" Height="620" MinWidth="760" MinHeight="500">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#22000000" BorderThickness="0,0,1,0">
            <ListBox x:Name="Navigation" SelectionChanged="Navigation_SelectionChanged">
                <ListBoxItem Content="システム"/><ListBoxItem Content="外観"/><ListBoxItem Content="会話"/>
                <ListBoxItem Content="音声"/><ListBoxItem Content="AI"/><ListBoxItem Content="記憶"/>
                <ListBoxItem Content="PC操作"/><ListBoxItem Content="ゲーム"/><ListBoxItem Content="通知"/>
                <ListBoxItem Content="キャラクター"/><ListBoxItem Content="権限"/><ListBoxItem Content="ショートカット"/>
            </ListBox>
        </Border>
        <ScrollViewer Grid.Column="1" Padding="32">
            <StackPanel>
                <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Text="システム"/>
                <TextBlock x:Name="PageDescription" Margin="0,10,0,28" TextWrapping="Wrap"/>
                <CheckBox Content="Windows起動時にるかを起動する" IsChecked="True" Margin="0,8"/>
                <CheckBox Content="ゲーム中は自動で端に退避する" IsChecked="True" Margin="0,8"/>
                <CheckBox Content="Discord通話中はウェイクワード待機にする" IsChecked="True" Margin="0,8"/>
                <CheckBox Content="危険なPC操作は必ず確認する" IsChecked="True" Margin="0,8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
